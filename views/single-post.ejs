<%- include('partials/header') %>

<main class="container single-post-container">
  <article class="single-post">
    <header class="single-header">
      <h1><%= post.title %></h1>
      <div class="meta">By <strong><%= post.author %></strong> &bull; <span><%= post.date %></span></div>
    </header>

    <section class="single-body">
      <%= post.body %>
    </section>

    <footer class="post-actions">
      <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.username === post.author)) { %>
        <a href="/post/<%= post.id %>/edit" class="btn btn-edit">Edit</a>

        <form action="/post/<%= post.id %>/delete" method="POST" style="display:inline">
          <button class="btn btn-danger" type="submit" onclick="return confirm('Delete this post?')">Delete</button>
        </form>
      <% } %>

      <a href="/post" class="btn btn-link">Back to posts</a>
    </footer>
  </article>
</main>

<%- include('partials/footer') %>