<%- include('partials/header') %>

<section class="auth-page">
  <div class="auth-card">
    <h2>Welcome back</h2>
    <p class="auth-sub">Log in to continue writing.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <p style="color: #c0392b; margin-bottom: 16px; font-weight: 600;"><%= error %></p>
    <% } %>

    <form action="/login" method="POST" class="auth-form">
      <input type="text" name="uid" placeholder="Email/Username" required />
      <input type="password" name="password" placeholder="Password" required />

      <button type="submit">Login</button>
    </form>

    <p class="auth-switch">Don't have an account? <a href="/signup">Sign up</a></p>
  </div>
</section>

<%- include('partials/footer') %>