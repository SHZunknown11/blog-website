<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Ink Wave</title>
</head>
<body>
    <header>
        <div class="container-nav">
            <div class="logo"><a href="/home"><img src="/images/logo.png" alt="Ink Wave"></a></div>
            <nav>
                <ul class="nav-links" id="navLinks">
                    <li><a href="/home">HOME</a></li>
                    <li><a href="/post">POST</a></li>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li><a href="/write-post">WRITE</a></li>
                        <li><a href="/logout">LOGOUT (<%= user.username %>)</a></li>
                    <% } else { %>
                        <li><a href="/login">LOGIN</a></li>
                        <li><a href="/signup">SIGNUP</a></li>
                    <% } %>
                </ul>
            </nav>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navLinks" type="button">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>
